{
  "expo": {
    "name": "Monster Plants Manager",
    "slug": "monster-plants-manager",
    "scheme": "monsterplantsmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7d268"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
